# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for uploaded documents (create this in Supabase Storage)
SUPABASE_DOCS_BUCKET=documents

# ---- OpenAI ----
OPENAI_API_KEY=
# Optional: if you want to export traces with a separate key
OPENAI_TRACING_EXPORT_API_KEY=

# Models (defaults are set in src/lib/ai/models.ts)
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-5-mini
OPENAI_DEEP_MODEL=gpt-5

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# We store embeddings in pgvector(1536)
OPENAI_EMBEDDING_DIM=1536

# App
NEXT_PUBLIC_APP_NAME=NonprofitOS
APP_BASE_URL=http://localhost:3000

# Optional: set a hard cap on uploaded file sizes (in MB)
MAX_UPLOAD_MB=15
